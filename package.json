{
  "name": "lexflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@lexflow/web",
    "dev:api": "npm run dev --workspace=@lexflow/api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present"
  }
}
